# ─────────────────────────────────────────────────────────────────
# Rising Waters — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# Flask
FLASK_ENV=development/production
SECRET_KEY=
DEBUG=True

# Database (leave empty to use SQLite in development)
DATABASE_URL=

# App domain (used in email links)
APP_DOMAIN=http://localhost:5000

# ── Google OAuth ─────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ── Email (Flask-Mail) ───────────────────────────────────────────
# For Gmail: enable 2FA → create App Password → use it as MAIL_PASSWORD
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True/False
MAIL_USE_SSL=False/True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
WEATHER_ALERT_INTERVAL_MINUTES=60
