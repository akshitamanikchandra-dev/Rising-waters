# ─────────────────────────────────────────────────────────────────
# Rising Waters — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────

# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-key
DEBUG=True

# Database (leave empty to use SQLite in development)
DATABASE_URL=

# App domain (used in email links)
APP_DOMAIN=http://localhost:5000

# ── Google OAuth ─────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Twilio SMS ───────────────────────────────────────────────────
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── Email (Flask-Mail) ───────────────────────────────────────────
# For Gmail: enable 2FA → create App Password → use it as MAIL_PASSWORD
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@floodprediction.com
